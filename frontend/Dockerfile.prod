FROM node:26-alpine

WORKDIR /app

# Copier package.json et package-lock.json
COPY package*.json ./

# Installer les dépendances
RUN npm ci

# Copier le code source
COPY . .

# Version shown in the app (git tag), read by Vite at build time
ARG VITE_APP_VERSION=unknown
ENV VITE_APP_VERSION=$VITE_APP_VERSION

# Définir l'environnement de production
ENV NODE_ENV=production

# Builder l'application avec les variables de production
RUN npm run build

# Point d'entrée par défaut pour copier les fichiers
CMD ["sh", "-c", "cp -r dist/* /output/ && echo 'Build files copied to volume'"]

# Copy this file to .env in each worktree. Never commit .env: it contains
# passwords, signing keys, and the Keycloak client secret.
#
# Keep only one profile active in .env. The profile is selected by APP_ENV.
# The values below are examples only and must be replaced before deployment.

# ---------------------------------------------------------------------------
# DEVELOPMENT PROFILE
# ---------------------------------------------------------------------------
# Use these values in the development worktree.
APP_ENV=dev
DEBUG=True

# Compose stack for this worktree. Read natively by docker compose, so a plain
# `docker compose <cmd>` from the worktree root picks the right files: no -f to
# type, and no risk of forgetting the external-volumes overlay.
# Only effective when the command is run from the worktree root.
COMPOSE_FILE=docker-compose.dev.yml:docker-compose.dev.external-volumes.yml

# External Docker volumes: single source of truth, shared by the compose
# overlay and the shell scripts. Leave a variable empty when this environment
# has no such volume (dev serves the frontend from Vite, so no frontend-dist).
API_DB_VOLUME=hornet-finder-dev-api-db-18
KEYCLOAK_DB_VOLUME=hornet-finder-dev-keycloak-db-18
FRONTEND_DIST_VOLUME=

# Storage backend for those volumes. When set, ./storage-init.sh creates one
# ZFS dataset per volume under this parent, and ./zfs-snapshot.sh operates on
# them. The dataset name is always <ZFS_PARENT>/<volume name>: Docker owns the
# layout underneath, so no path is ever derived from a dataset mountpoint.
# Leave empty on a non-ZFS host: the volumes are then plain local Docker
# volumes and no zfs command is ever run.
ZFS_PARENT=ZROOT/docker/volumes
DJANGO_SECRET_KEY=dev-change-this-django-secret
HOST=dev.velutina.ovh

# Development PostgreSQL credentials.
DB_PASSWORD=dev-change-this-api-db-password
KEYCLOAK_DB_PASSWORD=dev-change-this-keycloak-db-password

# This client must exist in the hornet-finder-dev realm.
KC_CLIENT_ID=hornet-api-dev
KC_CLIENT_SECRET=dev-change-this-client-secret
KC_BOOTSTRAP_ADMIN_PASSWORD=dev-change-this-bootstrap-password
KC_HOSTNAME=auth.dev.velutina.ovh

# Ad hoc: password for a dedicated Keycloak user (realm-management roles
# manage-realm + view-realm on the app realm, not master) used only by
# one-off admin scripts against the Keycloak REST Admin API (e.g. managing
# authentication flows). Not consumed by the docker-compose containers
# themselves. See KEYCLOAK_PASSKEY_FLOW_PROD.md for an example.
FLOW_ADMIN_PASSWORD=dev-change-this-flow-admin-password

# Bind the development reverse proxy to the development server address.
BIND_IP=127.0.0.1
PROXY_PORT=80
PROXY_SSL_PORT=443

# ---------------------------------------------------------------------------
# PRODUCTION PROFILE
# ---------------------------------------------------------------------------
# In the production worktree, replace the development block above with the
# following values. Do not keep both profiles active in the same .env file.
#
# APP_ENV=prod
# DEBUG=False
# COMPOSE_FILE=docker-compose.prod.yml:docker-compose.prod.external-volumes.yml
# API_DB_VOLUME=hornet-finder-api-db-18
# KEYCLOAK_DB_VOLUME=hornet-finder-keycloak-db-18
# FRONTEND_DIST_VOLUME=hornet-finder-frontend-dist
# ZFS_PARENT=ZROOT/docker/volumes
# DJANGO_SECRET_KEY=prod-change-this-django-secret
# HOST=velutina.ovh
# DB_PASSWORD=prod-change-this-api-db-password
# KEYCLOAK_DB_PASSWORD=prod-change-this-keycloak-db-password
# KC_CLIENT_ID=hornet-api
# KC_CLIENT_SECRET=prod-change-this-client-secret
# KC_BOOTSTRAP_ADMIN_PASSWORD=prod-change-this-bootstrap-password
# KC_HOSTNAME=auth.velutina.ovh
# FLOW_ADMIN_PASSWORD=prod-change-this-flow-admin-password
# BIND_IP=0.0.0.0
# PROXY_PORT=80
# PROXY_SSL_PORT=443
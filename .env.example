# Copy this file to .env in each worktree. Never commit .env: it contains
# passwords, signing keys, and the Keycloak client secret.
#
# Keep only one profile active in .env. The profile is selected by APP_ENV.
# The values below are examples only and must be replaced before deployment.

# ---------------------------------------------------------------------------
# DEVELOPMENT PROFILE
# ---------------------------------------------------------------------------
# Use these values in the development worktree.
APP_ENV=dev
DEBUG=True
DJANGO_SECRET_KEY=dev-change-this-django-secret
HOST=dev.velutina.ovh

# Development PostgreSQL credentials.
DB_PASSWORD=dev-change-this-api-db-password
KEYCLOAK_DB_PASSWORD=dev-change-this-keycloak-db-password

# This client must exist in the hornet-finder-dev realm.
KC_CLIENT_ID=hornet-api-dev
KC_CLIENT_SECRET=dev-change-this-client-secret
KC_BOOTSTRAP_ADMIN_PASSWORD=dev-change-this-bootstrap-password
KC_HOSTNAME=auth.dev.velutina.ovh

# Bind the development reverse proxy to the development server address.
BIND_IP=127.0.0.1
PROXY_PORT=80
PROXY_SSL_PORT=443

# ---------------------------------------------------------------------------
# PRODUCTION PROFILE
# ---------------------------------------------------------------------------
# In the production worktree, replace the development block above with the
# following values. Do not keep both profiles active in the same .env file.
#
# APP_ENV=prod
# DEBUG=False
# DJANGO_SECRET_KEY=prod-change-this-django-secret
# HOST=velutina.ovh
# DB_PASSWORD=prod-change-this-api-db-password
# KEYCLOAK_DB_PASSWORD=prod-change-this-keycloak-db-password
# KC_CLIENT_ID=hornet-api
# KC_CLIENT_SECRET=prod-change-this-client-secret
# KC_BOOTSTRAP_ADMIN_PASSWORD=prod-change-this-bootstrap-password
# KC_HOSTNAME=auth.velutina.ovh
# BIND_IP=0.0.0.0
# PROXY_PORT=80